FROM eclipse-temurin:21-jdk AS build
WORKDIR /opt/build
COPY gradlew gradlew
COPY gradle gradle
COPY build.gradle settings.gradle ./
RUN ./gradlew dependencies --no-daemon # own layer, so a source change doesn't refetch everything
COPY src src
RUN ./gradlew bootJar --no-daemon

FROM eclipse-temurin:21-alpine
WORKDIR /opt/app
COPY --from=build /opt/build/build/libs/casual-challenge-application-0.0.1-SNAPSHOT.jar app.jar
# no key file on the first start --> make one up, CliTools wants it in the working directory as well
ENTRYPOINT ["sh","-c","[ -f /run/secrets/jwt_private_key ] || tr -dc A-Za-z0-9 </dev/urandom | head -c 50 >/run/secrets/jwt_private_key; cp /run/secrets/jwt_private_key jwt_private_key.txt; exec java -Xms256m -Xmx1024m -jar -Dspring.profiles.active=local app.jar"]
